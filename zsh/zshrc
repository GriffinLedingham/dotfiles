### Kubernetes logs: pick a context, then a replica set, then tail all its pods.
# Usage: klogs [context]
function klogs() {
  local ctx=${1:-$(kubectl config get-contexts -o name | fzf --prompt='context> ')}
  [[ -z $ctx ]] && return
  # Skip scaled-down replica sets; old deployment revisions leave many behind.
  local rs=$(kubectl --context "$ctx" get rs -A --no-headers | awk '$3 > 0' | fzf --prompt='replicaset> ' | awk '{print $1, $2}')
  [[ -z $rs ]] && return
  local ns=${rs% *} name=${rs#* }
  local selector=$(kubectl --context "$ctx" get rs -n "$ns" "$name" -o json \
    | jq -r '.spec.selector.matchLabels | to_entries | map("\(.key)=\(.value)") | join(",")')
  kubectl --context "$ctx" logs -f --tail=200 --all-containers --prefix --max-log-requests=50 -n "$ns" -l "$selector"
}

# Open k9s on a picked context.
# Usage: k9 [context]
function k9() {
  local ctx=${1:-$(kubectl config get-contexts -o name | fzf --prompt='context> ')}
  [[ -z $ctx ]] && return
  k9s --context "$ctx"
}

