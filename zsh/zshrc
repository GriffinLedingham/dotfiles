# ---- nvm: fast startup (the old `source $(brew --prefix nvm)/nvm.sh` was ~360ms) ----
# Put the default node version on PATH directly using cheap file/glob ops, so we
# never source the slow nvm.sh at login. node/npm/npx resolve exactly as before.
export NVM_DIR="$HOME/.nvm"
NVM_SH="/opt/homebrew/opt/nvm/nvm.sh"
if [[ -d "$NVM_DIR/versions/node" ]]; then
  _nvm_def="${$(<$NVM_DIR/alias/default):-}"
  _nvm_vers=( $NVM_DIR/versions/node/v${_nvm_def#v}*(/Nn) )
  (( ${#_nvm_vers} )) && path=( ${_nvm_vers[-1]}/bin $path )
  unset _nvm_def _nvm_vers
fi
# Load the full nvm machinery only the first time you actually call `nvm`
# (e.g. `nvm use`, `nvm install`, `nvm ls`).
nvm() {
  unset -f nvm
  [ -s "$NVM_SH" ] || NVM_SH="$(brew --prefix nvm 2>/dev/null)/nvm.sh"
  [ -s "$NVM_SH" ] && source "$NVM_SH"
  nvm "$@"
}
